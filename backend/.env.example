# AI Family Assistant — Backend Environment Variables
# کپی به .env و مقداردهی برای هر محیط (local/staging/production)

NODE_ENV=development
PORT=3000

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=aifamily
DB_PASSWORD=aifamily_dev_password
DB_DATABASE=aifamily_dev
DB_SSL=false

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Auth / JWT (فصل ۱۵ Security Architecture) ---
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=30d

# --- Command Signing (Ed25519 — فصل ۳۷ Command Matrix) ---
COMMAND_SIGNING_PRIVATE_KEY=
COMMAND_SIGNING_PUBLIC_KEY=

# --- AI Provider Abstraction (فصل ۱۳) ---
AI_PRIMARY_PROVIDER=openai
AI_FALLBACK_PROVIDER=anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Location Encryption (AES-256-GCM — فصل ۱۲) ---
LOCATION_ENCRYPTION_KEY=CHANGE_ME_32_byte_base64_key

# AI Family Assistant — Backend Environment Variables
# کپی به .env و مقداردهی برای هر محیط (local/staging/production)

NODE_ENV=development
PORT=3000

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=aifamily
DB_PASSWORD=aifamily_dev_password
DB_DATABASE=aifamily_dev
DB_SSL=false

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Auth / JWT (فصل ۱۵ Security Architecture) ---
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=30d

# --- Command Signing (Ed25519، امضای غیرمتقارن واقعی — نه دیگر HMAC) ---
# Seed خصوصی خام ۳۲ بایتی (دقیقاً ۶۴ کاراکتر Hex) — فقط روی سرور می‌ماند، هرگز به Device Agent
# داده نمی‌شود. برای تولید یک مقدار واقعی تصادفی: openssl rand -hex 32
COMMAND_SIGNING_PRIVATE_KEY_HEX=CHANGE_ME_64_hex_chars_32_byte_ed25519_seed_______________
# کلید عمومی متناظر (مشتق‌شده از همان Seed بالا، نه رمز) همان مقداری است که باید به‌عنوان
# Gradle Property COMMAND_SIGNING_PUBLIC_KEY_HEX به Build اپ Device Agent داده شود. برای محاسبه
# آن از روی Seed، در پوشه backend اجرا کنید:
# node -e "const s=Buffer.from(process.argv[1],'hex');const c=require('crypto');const der=Buffer.concat([Buffer.from('302e020100300506032b657004220420','hex'),s]);const pk=c.createPrivateKey({key:der,format:'der',type:'pkcs8'});const pub=c.createPublicKey(pk).export({format:'jwk'});console.log(Buffer.from(pub.x,'base64url').toString('hex'))" COMMAND_SIGNING_PRIVATE_KEY_HEX_VALUE

# --- AI Provider Abstraction (فصل ۱۳) ---
AI_PRIMARY_PROVIDER=openai
AI_FALLBACK_PROVIDER=anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Location Encryption (AES-256-GCM — فصل ۱۲) ---
LOCATION_ENCRYPTION_KEY=CHANGE_ME_32_byte_base64_key
